<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_app">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SKINS &amp; CAPES"
        android:textColor="@color/primary_text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />
    <TextView
        android:id="@+id/skin_cape_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Import a PNG skin or cape to preview it in 3D."
        android:textColor="@color/secondary_text"
        android:textSize="13sp"
        android:paddingBottom="10dp" />
    <WebView
        android:id="@+id/skin_cape_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="12dp">
        <Button
            android:id="@+id/skin_choose_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Choose Skin PNG" />
        <Button
            android:id="@+id/cape_choose_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Choose Cape PNG" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Local preview and storage only. Showing an offline skin to other players requires compatible server-side support."
        android:textColor="@color/secondary_text"
        android:textSize="11sp"
        android:paddingTop="8dp" />
</LinearLayout>
