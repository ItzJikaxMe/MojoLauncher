<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <LinearLayout
        android:id="@+id/home_sidebar"
        android:layout_width="@dimen/_112sdp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/nav_sidebar_background"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="7dp"
        android:paddingBottom="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="9dp"
            android:paddingBottom="2dp"
            android:text="GAME MENU"
            android:textColor="@color/gold_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="9dp"
            android:paddingBottom="8dp"
            android:text="Choose your destination"
            android:textColor="@color/secondary_text"
            android:textSize="9sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="7dp"
            android:background="@color/gold_divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nav_play"
                    style="@style/LauncherNavItem"
                    android:drawableStart="@drawable/ic_px_java_run"
                    android:text="Play"
                    />

                <TextView
                    android:id="@+id/nav_mods"
                    style="@style/LauncherNavItem"
                    android:drawableStart="@drawable/ic_px_file"
                    android:text="Mods"  />

                <TextView
                    android:id="@+id/nav_resourcepacks"
                    style="@style/LauncherNavItem"
                    android:drawableStart="@drawable/ic_px_image"
                    android:text="Resource Packs"  />

                <TextView
                    android:id="@+id/nav_shaders"
                    style="@style/LauncherNavItem"
                    android:drawableStart="@drawable/ic_px_experiment"
                    android:text="Shaders"  />

                <TextView
                    android:id="@+id/nav_modpacks"
                    style="@style/LauncherNavItem"
                    android:drawableStart="@drawable/ic_modrinth"
                    android:text="Modpacks" />

                <TextView
                    android:id="@+id/nav_skins_capes"
                    style="@style/LauncherNavItem"
                    android:drawableStart="@drawable/ic_px_image_renderer"
                    android:text="Skins &amp; Capes"  />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="7dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="7dp"
                    android:background="@color/gold_divider" />

                <TextView
                    android:id="@+id/nav_controls"
                    style="@style/LauncherNavItem"
                    android:drawableStart="@drawable/ic_px_gamepad"
                    android:text="Controls" />

                <TextView
                    android:id="@+id/nav_more"
                    style="@style/LauncherNavItem"
                    android:drawableStart="@drawable/ic_info_outline"
                    android:text="More" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:text="JIKAXMC  •  1.0"
            android:textColor="@color/gold_muted"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/home_main_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:padding="9dp"
        app:layout_constraintStart_toEndOf="@id/home_sidebar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/play_section"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/home_feature_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/home_play_card"
                android:padding="17dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/home_version_label"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent="0.57">

                <TextView
                    android:id="@+id/home_hero_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MINECRAFT  •  JAVA EDITION"
                    android:textColor="@color/gold_soft"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/home_hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="YOUR NEXT&#10;ADVENTURE STARTS HERE"
                    android:textColor="@color/primary_text"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.025"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/home_hero_eyebrow" />

                <TextView
                    android:id="@+id/home_hero_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Choose a version, prepare your world, and play."
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp"
                    app:layout_constraintStart_toStartOf="@id/home_hero_title"
                    app:layout_constraintTop_toBottomOf="@id/home_hero_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="2dp"
                    android:text="✦"
                    android:textColor="@color/gold_primary"
                    android:textSize="58sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/home_version_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="SELECT YOUR GAME VERSION"
                android:textColor="@color/gold_soft"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/mc_version_spinner" />

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="@dimen/_42sdp"
                android:background="@drawable/account_header_background"
                android:drawableEnd="@drawable/spinner_arrow"
                app:drawableEndSize="@dimen/_12sdp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="@dimen/_30sdp"
                app:drawableEndPadding="@dimen/_4sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/edit_profile_button"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/launcher_nav_item"
                android:contentDescription="Edit selected version"
                android:src="@drawable/ic_px_edit"
                android:tint="@color/gold_soft"
                android:padding="9dp"
                app:layout_constraintStart_toEndOf="@id/mc_version_spinner"
                app:layout_constraintEnd_toStartOf="@id/add_version_button"
                app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
                app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

            <TextView
                android:id="@+id/add_version_button"
                android:layout_width="@dimen/_104sdp"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/gold_action_button"
                android:gravity="center"
                android:text="+  ADD VERSION"
                android:textColor="@color/background_app"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:layout_constraintStart_toEndOf="@id/edit_profile_button"
                app:layout_constraintEnd_toStartOf="@id/play_button"
                app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
                app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="@dimen/_108sdp"
                android:layout_height="@dimen/_42sdp"
                android:text="@string/main_play"
                android:textAllCaps="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
                app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/home_dynamic_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@color/background_app" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
