<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background">

    <LinearLayout
        android:id="@+id/home_sidebar"
        android:layout_width="@dimen/_110sdp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/nav_sidebar_background"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingBottom="2dp"
            android:text="GAME MENU"
            android:textColor="@color/launcher_green_bright"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.10" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingBottom="6dp"
            android:text="Choose your destination"
            android:textColor="@color/launcher_muted"
            android:textSize="8sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="5dp"
            android:layout_marginBottom="6dp"
            android:background="@color/launcher_panel_border" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/nav_play"
                    style="@style/LauncherNavCard">
                    <FrameLayout
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:background="@drawable/nav_icon_tile">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_px_java_run"
                            android:tint="@color/launcher_green_bright"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                    <TextView style="@style/LauncherNavLabel" android:layout_marginStart="5dp" android:text="Play" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_mods"
                    style="@style/LauncherNavCard">
                    <FrameLayout
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:background="@drawable/nav_icon_tile">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_vornex_mods"
                            android:tint="@color/launcher_green_bright"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                    <TextView style="@style/LauncherNavLabel" android:layout_marginStart="5dp" android:text="Mods" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_resourcepacks"
                    style="@style/LauncherNavCard">
                    <FrameLayout
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:background="@drawable/nav_icon_tile">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_vornex_resourcepacks"
                            android:tint="@color/launcher_green_bright"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                    <TextView style="@style/LauncherNavLabel" android:layout_marginStart="5dp" android:text="Resource Packs" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_shaders"
                    style="@style/LauncherNavCard">
                    <FrameLayout
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:background="@drawable/nav_icon_tile">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_vornex_shaders"
                            android:tint="@color/launcher_green_bright"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                    <TextView style="@style/LauncherNavLabel" android:layout_marginStart="5dp" android:text="Shaders" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_modpacks"
                    style="@style/LauncherNavCard">
                    <FrameLayout
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:background="@drawable/nav_icon_tile">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_vornex_modpacks"
                            android:tint="@color/launcher_green_bright"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                    <TextView style="@style/LauncherNavLabel" android:layout_marginStart="5dp" android:text="Modpacks" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_skins_capes"
                    style="@style/LauncherNavCard">
                    <FrameLayout
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:background="@drawable/nav_icon_tile">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_px_image_renderer"
                            android:tint="@color/launcher_green_bright"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                    <TextView style="@style/LauncherNavLabel" android:layout_marginStart="5dp" android:text="Skins &amp; Capes" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="5dp"
                    android:background="@color/launcher_panel_border" />

                <LinearLayout
                    android:id="@+id/nav_controls"
                    style="@style/LauncherNavCard">
                    <FrameLayout
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:background="@drawable/nav_icon_tile">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_px_gamepad"
                            android:tint="@color/launcher_green_bright"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                    <TextView style="@style/LauncherNavLabel" android:layout_marginStart="5dp" android:text="Controls" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_more"
                    style="@style/LauncherNavCard">
                    <FrameLayout
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:background="@drawable/nav_icon_tile">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_info_outline"
                            android:tint="@color/launcher_green_bright"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                    <TextView style="@style/LauncherNavLabel" android:layout_marginStart="5dp" android:text="More" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:text="JIKAXMC  •  1.0"
            android:textColor="@color/launcher_muted"
            android:textSize="7sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/home_main_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:padding="6dp"
        app:layout_constraintStart_toEndOf="@id/home_sidebar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/play_section"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/home_feature_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/home_play_card"
                android:padding="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/home_version_label"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent="0.52">

                <TextView
                    android:id="@+id/home_hero_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MINECRAFT  •  JAVA EDITION"
                    android:textColor="@color/launcher_green_bright"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/home_hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="YOUR NEXT&#10;ADVENTURE STARTS HERE"
                    android:textColor="@color/launcher_text"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/home_hero_eyebrow" />

                <TextView
                    android:id="@+id/home_hero_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Choose a version, prepare your world, and play."
                    android:textColor="@color/launcher_muted"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="@id/home_hero_title"
                    app:layout_constraintTop_toBottomOf="@id/home_hero_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="✦"
                    android:textColor="@color/launcher_green"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/home_version_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="SELECT YOUR GAME VERSION"
                android:textColor="@color/launcher_green_bright"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/mc_version_spinner" />

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:background="@drawable/account_header_background"
                android:drawableEnd="@drawable/spinner_arrow"
                app:drawableEndSize="10dp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="24dp"
                app:drawableEndPadding="3dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/edit_profile_button"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="30dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/launcher_nav_item"
                android:contentDescription="Edit selected version"
                android:src="@drawable/ic_px_edit"
                android:tint="@color/launcher_green_bright"
                android:padding="7dp"
                app:layout_constraintStart_toEndOf="@id/mc_version_spinner"
                app:layout_constraintEnd_toStartOf="@id/add_version_button"
                app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
                app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

            <TextView
                android:id="@+id/add_version_button"
                android:layout_width="86dp"
                android:layout_height="34dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/gold_action_button"
                android:gravity="center"
                android:text="+  ADD VERSION"
                android:textColor="@color/launcher_text"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:layout_constraintStart_toEndOf="@id/edit_profile_button"
                app:layout_constraintEnd_toStartOf="@id/play_button"
                app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
                app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="94dp"
                android:layout_height="34dp"
                android:text="@string/main_play"
                android:textAllCaps="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
                app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/home_dynamic_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@color/launcher_background" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
