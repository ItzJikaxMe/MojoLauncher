<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/nav_item_selected_start" android:endColor="@color/nav_item_selected_end" />
            <corners android:radius="9dp" />
            <stroke android:width="1dp" android:color="@color/gold_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_item_background" />
            <corners android:radius="9dp" />
            <stroke android:width="1dp" android:color="#24394A" />
        </shape>
    </item>
</selector>