<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/launcher_green_dark" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="@color/launcher_green_bright" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/launcher_panel" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="@color/launcher_panel_border" />
        </shape>
    </item>
</selector>
